views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Research/Conferences/Cosmology and Galaxy Astrophysics with Simulations and Machine Learning/Presentation Notes")
    order:
      - file.name
      - Simulations Used
      - Code/Program Developed/Used
      - Type of ML used
      - Day
    sort:
      - property: Day
        direction: ASC
