views:
  - type: table
    name: All Recipes
    filters:
      and:
        - file.inFolder("Personal/Repertoire/Recipes")
        - Vegetarian == true
        - note["Type of Food"].contains("Dessert")
    order:
      - file.name
      - rating
      - Type of Food
      - Vegetarian
      - URL
      - Marinate?
  - type: table
    name: Entree
    filters:
      and:
        - file.inFolder("Personal/Repertoire/Recipes")
        - note["Type of Food"].contains("Entree")
    order:
      - file.name
      - rating
      - Type of Food
      - Vegetarian
      - URL
      - Marinate?
  - type: table
    name: Vegetarian
    filters:
      and:
        - file.inFolder("Personal/Repertoire/Recipes")
        - Vegetarian == true
        - '!note["Type of Food"].contains("Dessert")'
    order:
      - file.name
      - rating
      - Type of Food
      - Vegetarian
      - URL
      - Marinate?
  - type: table
    name: Dessert
    filters:
      and:
        - file.inFolder("Personal/Repertoire/Recipes")
        - note["Type of Food"].contains("Dessert")
    order:
      - file.name
      - rating
      - Type of Food
      - Vegetarian
      - URL
      - Marinate?
