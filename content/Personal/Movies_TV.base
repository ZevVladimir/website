views:
  - type: cards
    name: Movies/TV Watched
    filters:
      and:
        - file.inFolder("Personal/Movies_TV")
        - '!file.name.endsWith("base")'
        - "!rating.isEmpty()"
    order:
      - file.name
      - rating
      - scoreImdb
      - categories
    sort:
      - property: Created
        direction: DESC
    image: note.cover
  - type: cards
    name: Movies/TV TBW
    filters:
      and:
        - file.inFolder("Personal/Movies_TV")
        - '!file.name.endsWith("base")'
        - rating.isEmpty()
    order:
      - file.name
      - rating
      - scoreImdb
      - categories
    image: note.cover
  - type: cards
    name: New Seasons
    filters:
      and:
        - file.inFolder("Personal/Movies_TV")
        - '!file.name.endsWith("base")'
        - Status == "New Season"
    order:
      - file.name
      - rating
      - scoreImdb
      - categories
    image: note.cover
