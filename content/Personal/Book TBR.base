views:
  - type: cards
    name: Books Read
    filters:
      and:
        - file.inFolder("Personal/Book TBR/Books")
        - rating != "TBR"
        - yearRead == 2026
    order:
      - file.name
      - authors
      - rating
      - category
    sort:
      - property: dateFinished
        direction: DESC
      - property: rating
        direction: DESC
      - property: yearRead
        direction: DESC
    image: note.coverUrl
    cardSize: 170
    imageAspectRatio: 1.25
    imageFit: contain
  - type: cards
    name: Books To Be Read
    filters:
      and:
        - rating == ["TBR"]
    order:
      - file.name
      - authors
      - rating
      - category
    sort:
      - property: dateFinished
        direction: DESC
      - property: rating
        direction: DESC
      - property: yearRead
        direction: DESC
    image: note.coverUrl
    cardSize: 250
    imageAspectRatio: 1.25
    imageFit: contain
  - type: cards
    name: Books Read All
    filters:
      and:
        - file.inFolder("Personal/Book TBR/Books")
        - rating != ["TBR"]
    order:
      - file.name
      - authors
      - rating
      - category
    sort:
      - property: dateFinished
        direction: DESC
      - property: rating
        direction: DESC
      - property: yearRead
        direction: DESC
    image: note.coverUrl
    cardSize: 250
    imageAspectRatio: 1.25
    imageFit: contain
